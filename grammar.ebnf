(* Grammar for Practice 8 Language in EBNF *)
(* Languages and Compilers Design *)

program       ::= { struct_def } { fn_def } { statement } exit ;

struct_def    ::= "struct" ident NL "{" NL field_def { field_def } { member_fn_def } "}" NL ;

field_def     ::= type [ "mut" ] ident NL ;

member_fn_def ::= "fn" ident ":=" "(" [ param_list ] ")" "->" type NL block ;

fn_def        ::= "fn" ident ":=" "(" [ param_list ] ")" "->" type NL block ;

param_list    ::= param { "," param } ;

param         ::= type ident ;

statement     ::= decl | assign | if_stmt | while_stmt | print_stmt | lambda ;

lambda        ::= "fn" ident ":=" "[" [ capture_list ] "]" "(" [ param_list ] ")" "->" type NL block ;

capture_list  ::= capture { "," capture } ;

capture       ::= ident ;

decl          ::= type [ "mut" ] ident "{" init_item { "," init_item } "}" NL ;

init_item     ::= expr | "{" init_item { "," init_item } "}" ;

assign        ::= ( ident | ident { "." ident } ) ":=" expr NL ;

print_stmt    ::= "print" "(" ( expr | string_literal ) ")" NL ;

exit          ::= "exit" factor NL ;

if_stmt       ::= "if" expr NL block [ "else" NL block ] ;

while_stmt    ::= "while" expr NL block ;

block         ::= "{" NL { statement } [ exit ] "}" NL ;

expr          ::= arith [ ( "==" | "!=" ) arith ] ;

arith         ::= term { ( "+" | "-" ) term } ;

term          ::= factor { "*" factor } ;

factor        ::= number
                | "true"
                | "false"
                | "!" factor
                | "read" "(" ")"
                | ( ident | call ) { chain_elem } ;

call          ::= ident "(" [ arg_list ] ")" ;

arg_list      ::= expr { "," expr } ;

chain_elem    ::= "." ident [ "(" [ arg_list ] ")" ] ;

type          ::= "i32" | "i64" | "bool" | ident ;
